# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Required API Keys ────────────────────────────────────────────────────────
# NewsAPI.ai (Event Registry) key
NEWSAPI_AI_KEY=

# ── AI Scoring & Summaries (Optional but Recommended) ────────────────────────
# Gemini writes the summary, the "why it matters" line and urgency score.
# Without it the app falls back to keyword classification and still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Vercel Cron Protection (Optional) ────────────────────────────────────────
# Secret token to protect the /api/cron endpoint from unauthorized requests
# CRON_SECRET=

# ── Initial Admin Setup (Optional / Non-interactive setup) ───────────────────
# If set, npm run setup will automatically create this admin account without prompt.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_this_to_a_secure_password
# ADMIN_DISPLAY_NAME=Admin

# ── Server & Cookies ─────────────────────────────────────────────────────────
PORT=3000
# Set to true when serving over HTTPS (always true on Vercel production).
SECURE_COOKIES=true

# ── Collection cycle (Local node-cron / optional override) ───────────────────
CRON_SCHEDULE=0 2,14 * * *
TZ_NAME=Asia/Kolkata
RESULTS_PER_QUERY=10
REQUEST_DELAY_MS=500
