# ── Required ────────────────────────────────────────────────────────────────
# NewsAPI.ai (Event Registry) key — same one the old scraper used.
NEWSAPI_AI_KEY=

# ── Optional but recommended ────────────────────────────────────────────────
# Gemini writes the summary, the "why it matters" line and the score.
# Without it the app falls back to keyword classification and still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Where the SQLite file lives. Defaults to ./data/leads.db
# On Render with Persistent Disk, set to: /var/data/leads.db
# DB_PATH=/var/data/leads.db

# ── Initial Admin Setup (Non-interactive / Render automated deploy) ────────
# If set, npm run setup will automatically create this admin account without prompt.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_this_to_a_secure_password
# ADMIN_DISPLAY_NAME=Admin

# ── Collection cycle ────────────────────────────────────────────────────────
# Default: 2am and 2pm daily.
CRON_SCHEDULE=0 2,14 * * *
TZ_NAME=Asia/Kolkata
# DISABLE_SCHEDULER=true
RESULTS_PER_QUERY=10
REQUEST_DELAY_MS=500

# Set to true only when serving over HTTPS (always true on Render).
SECURE_COOKIES=true

